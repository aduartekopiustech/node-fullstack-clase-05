<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}}</title>
    <style>
      body {
        max-width: 40rem;
        margin: 2rem auto;
        padding: 0 1.5rem;
        font-family: system-ui, sans-serif;
        line-height: 1.6;
